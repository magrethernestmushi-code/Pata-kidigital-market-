{
  "name": "pata-kidigital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:deploy && next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx -r tsconfig-paths/register src/db/scripts/seed.ts",
    "db:deploy": "drizzle-kit push --force && npm run db:seed",
    "postinstall": "exit 0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
